NVIDIA_NIM_API_KEY=nvapi-...                     # from build.nvidia.com
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1/
MODEL_ID=local/minilm        # local/minilm, nvidia_nim/google/gemma-4-31b-it, offline/scripted
CONFIDENCE_THRESHOLD=0.75
LLM_MODE=live          # live | replay
MINILM_MODE=fewshot   # fewshot or zeroshot
AGENT_MODE=tools
